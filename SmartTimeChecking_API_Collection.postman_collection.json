    {
      "key": "baseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "devToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "leadToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "hrToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "activeQrPayload",
      "value": "",
      "type": "string"
    },
    {
      "key": "pendingEmergencyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdRequestId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication & RBAC",
      "item": [
        {
          "name": "1.1 Login Dev (Lê Hoàng Nam - Developer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.success).to.be.true;",
                  "pm.collectionVariables.set('devToken', jsonData.data.token);",
                  "pm.test('Dev Token generated', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"dev@congty.com\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login-dev"
          }
        },
        {
          "name": "1.2 Login Manager (Trần Văn Mạnh - Tech Lead)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.success).to.be.true;",
                  "pm.collectionVariables.set('leadToken', jsonData.data.token);",
                  "pm.test('Lead Token generated', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"lead@congty.com\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login-dev"
          }
        },
        {
          "name": "1.3 Login HR (Nguyễn Thị Thu - HR Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.success).to.be.true;",
                  "pm.collectionVariables.set('hrToken', jsonData.data.token);",
                  "pm.test('HR Token generated', function () { pm.response.to.have.status(200); });"
