    {
      "name": "02. Kiosk Dynamic QR & Multi-Factor Punch (Biên & Lỗi)",
      "item": [
        {
          "name": "2.1 Lấy mã Kiosk QR mới nhất",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.success).to.be.true;",
                  "pm.collectionVariables.set('activeQrPayload', jsonData.data.qrPayload);",
                  "pm.test('Got active QR', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/kiosk/current-qr"
          }
        },
        {
          "name": "2.2 [SUCCESS] Chấm công Vào ca chuẩn (Đúng IP, Đúng Thiết bị, QR hợp lệ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Punch IN status 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.data.status).to.eql('VALID');",
                  "pm.expect(jsonData.data.punchType).to.eql('IN');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{devToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrPayload\": \"{{activeQrPayload}}\",\n  \"deviceToken\": \"FP_DEVICE_TOKEN_DEV_IPHONE_15_PRO\",\n  \"punchType\": \"IN\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/attendance/punch"
          }
        },
        {
          "name": "2.3 [FAILED - BIÊN] Quét lại mã QR vừa dùng (Replay Attack)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Expected 400 ERR_QR_EXPIRED', function () { pm.response.to.have.status(400); });",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.code).to.eql('ERR_QR_EXPIRED');",
                  "pm.expect(jsonData.hrGuide).to.include('Mã Dynamic QR tự động xoay 5 giây/lần');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{devToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrPayload\": \"{{activeQrPayload}}\",\n  \"deviceToken\": \"FP_DEVICE_TOKEN_DEV_IPHONE_15_PRO\",\n  \"punchType\": \"IN\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/attendance/punch"
          }
        },
        {
          "name": "2.4 [FAILED - BẢO MẬT] Sửa chữ ký HMAC mã QR (Tampered QR Attack)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Expected 400 ERR_INVALID_QR', function () { pm.response.to.have.status(400); });",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.code).to.eql('ERR_INVALID_QR');",
                  "pm.expect(jsonData.hrGuide).to.include('Kiểm tra camera quét có bị mờ hoặc có can thiệp payload');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{devToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrPayload\": \"OFFICE_HQ_FLOOR_1|1731514800|hacker-nonce|fake-signature\",\n  \"deviceToken\": \"FP_DEVICE_TOKEN_DEV_IPHONE_15_PRO\",\n  \"punchType\": \"IN\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/attendance/punch"
          }
        },
        {
          "name": "2.5 [FAILED - GIAN LẬN] Chấm công bằng thiết bị chưa đăng ký (Device Mismatch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Expected 400 ERR_DEVICE_MISMATCH', function () { pm.response.to.have.status(400); });",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.code).to.eql('ERR_DEVICE_MISMATCH');",
                  "pm.expect(jsonData.hrGuide).to.include('HR/IT kiểm tra xem nhân viên có đổi điện thoại mới không');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{devToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrPayload\": \"OFFICE_HQ_FLOOR_1|1731514800|nonce|sig\",\n  \"deviceToken\": \"UNKNOWN_COLLEAGUE_PHONE\",\n  \"punchType\": \"IN\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/attendance/punch"
          }
        },
        {
          "name": "2.6 Lịch sử chấm công theo khoảng thời gian",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{dev_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/attendance/history?startDate=2026-10-01&endDate=2026-11-14",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "history"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-10-01"
                },
                {
                  "key": "endDate",
                  "value": "2026-11-14"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03. Emergency Fallback & GPS Fraud Detection",
      "item": [
        {
          "name": "3.1 [SUCCESS / WARNING] Chấm công Khẩn cấp Selfie có toạ độ xa VP (> 200m)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.success).to.be.true;",
                  "pm.expect(jsonData.data.status).to.eql('PENDING_APPROVAL');",
                  "pm.expect(jsonData.data.rejectionReason).to.include('FLAG_LOCATION_MISMATCH');",
                  "pm.collectionVariables.set('pendingEmergencyId', jsonData.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{devToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "latitude",
                  "value": "21.028511",
                  "type": "text"
                },
                {
                  "key": "longitude",
                  "value": "105.854444",
                  "type": "text"
                },
                {
                  "key": "reason",
                  "value": "Công ty mất điện, không mở được màn hình Kiosk QR",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/attendance/punch-emergency"
          }
        },
        {
          "name": "3.2 Quản lý xem danh sách chấm công khẩn cấp",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{leadToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/attendance/emergency-pending"
          }
        },
        {
          "name": "3.3 Quản lý Phê duyệt ca Chấm công khẩn cấp",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.data.status).to.eql('VALID');",
                  "pm.test('Emergency punch approved', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{leadToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\",\n  \"comment\": \"Đã xác nhận sự cố mất điện tòa nhà lúc 8h15\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/attendance/emergency/{{pendingEmergencyId}}/review"
          }
        }
      ]
    },
    {
      "name": "04. Request Engine & Quota Edge Cases",
      "item": [
        {
          "name": "4.1 Xem Hạn ngạch (Quota) còn lại trong tháng",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{devToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/requests/quotas/remaining"
          }
        },
        {
          "name": "4.2 [FAILED - BIÊN] Tạo đơn Đi muộn > 60 phút (Chặn thời lượng tối đa)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Expected 400 ERR_QUOTA_EXCEEDED', function () { pm.response.to.have.status(400); });",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.code).to.eql('ERR_QUOTA_EXCEEDED');",
                  "pm.expect(jsonData.message).to.include('Thời lượng đi muộn/về sớm tối đa là 60 phút/lần');",
                  "pm.expect(jsonData.hrGuide).to.include('Quy chế công ty giới hạn: Đi muộn tối đa 2 lần/tháng');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{devToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestType\": \"LATE_IN\",\n  \"fromDate\": \"2026-11-14\",\n  \"toDate\": \"2026-11-14\",\n  \"durationMinutes\": 75,\n  \"reason\": \"Kẹt xe quá nặng\"\n}"
